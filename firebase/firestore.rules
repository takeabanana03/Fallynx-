rules_version = '2';

// Phase 5. Two rules matter: a user reads only their own data, and a
// contact reads only the alerts that name them. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /contacts/{contactId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /alerts/{alertId} {
      // The person who raised it, or anyone listed as a watcher.
      allow read: if isOwner(resource.data.uid)
                  || (signedIn() && request.auth.uid in resource.data.watcherIds);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid);
      allow delete: if false;
    }

    match /journeys/{journeyId} {
      allow read: if isOwner(resource.data.uid)
                  || (signedIn() && request.auth.uid in resource.data.watcherIds);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid);
      allow delete: if false;
    }
  }
}
